# ── Credentials & secrets ─────────────────────────────────────────
hf_credential
*.token
.env
.env.*
!*.example

# ── Workspace (datasets, model weights) ──────────────────────────
workspace/

# ── Python ────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
build/
dist/

# ── IDE & editors ─────────────────────────────────────────────────
.vscode/
.idea/
*.code-workspace

# ── OS artifacts ──────────────────────────────────────────────────
.DS_Store
Thumbs.db
*~

# ── Misc artifacts ────────────────────────────────────────────────
tmp/
*.log
wandb/
local_*

# ── Spikes: 脚本/报告/指标入库，大二进制产物留本地 ────────────────
!spikes/**/*.log
spikes/**/*.mlpackage
spikes/**/*.mlmodelc
spikes/**/*.pt
spikes/**/*.npy
spikes/**/*.npz
spikes/**/vendor/
spikes/**/.build/
spikes/**/*.o

# ── Migration: 脚本/报告/指标/embedding 包入库，大二进制产物留本地 ──
!migration/**/*.log
migration/**/*.mlpackage
migration/**/*.mlmodelc
migration/**/out/data/
migration/**/*.pt

# ── Symlink (user creates locally: ln -sf common/assets assets) ──
/assets
# end of file
